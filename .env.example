# Database Configuration (Neon Postgres / standard postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
POSTGRES_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="your-jwt-secret-key-here"

# Cloudflare R2 Object Storage (Unlimited File Size Video Uploads, $0 Egress Bandwidth)
# 1. R2 Account ID found in Cloudflare Dashboard -> R2 Overview (right sidebar)
R2_ACCOUNT_ID="your-cloudflare-account-id"
# 2. R2 API Token credentials created under "Manage R2 API Tokens"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# 3. Your R2 Bucket Name
R2_BUCKET_NAME="kmm-training-videos"
# 4. Public bucket domain or custom domain (e.g. https://pub-xxxx.r2.dev or https://media.kiddiesmedia.org)
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Cloudinary Storage Configuration (Legacy / Thumbnails)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
